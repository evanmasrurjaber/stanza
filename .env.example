# Copy to .env (git-ignored) and fill in. Never commit real keys.

PORT=3000
NODE_ENV=development

# Google AI Studio key — free tier, do NOT link billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq console key.
GROQ_API_KEY=
GROQ_MAIN_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Limits
LLM_TIMEOUT_MS=60000
MAX_TRANSCRIPT_CHARS=200000
MAX_AUDIO_MB=200
MAX_AUDIO_SECONDS=7200
AUDIO_BITRATE=24k
RATE_LIMIT_PER_MIN=5
QUOTE_MATCH_THRESHOLD=0.9

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173
