{
  "name": "stanza",
  "private": true,
  "description": "AI podcast companion: summaries, chapters and grounded quizzes from a transcript or audio.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
